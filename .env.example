# ============================================================================
# Student Event Registration & Alumni Portal - Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to version control (it is in .gitignore).
# No value below is a real production secret - replace every one of them.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# The single origin the browser client is served from. Used for CORS + cookies.
CLIENT_ORIGIN=http://localhost:5000

# --- MySQL database ----------------------------------------------------------
# Strongly recommended: run "npm run db:setup" which creates a least-privilege
# application user for you. Then use the APP user's credentials here - never root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_portal
DB_USER=student_portal_app
DB_PASSWORD=change-me-to-a-strong-password
DB_CONNECTION_LIMIT=10

# --- JWT secrets -------------------------------------------------------------
# Generate strong values, e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both must be at least 32 characters. They are REQUIRED - the app refuses to
# start in production without them.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long

# Access tokens are intentionally short lived (~15 minutes).
JWT_ACCESS_EXPIRES=15m
# Refresh tokens live 7 days and are stored in an HttpOnly cookie.
JWT_REFRESH_EXPIRES_DAYS=7

# --- Email (Nodemailer) ------------------------------------------------------
# Leave SMTP_HOST empty to use DEV EMAIL MODE: verification / reset URLs and
# message bodies are printed to the server console instead of being sent.
# This is a safe development default - no external mail server is contacted.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Student Portal <no-reply@student-portal.local>"

# --- File uploads (profile pictures) ----------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# --- Security knobs ----------------------------------------------------------
# Global API rate limit: 100 requests per 15 minutes per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Login rate limit: 5 attempts per 15 minutes per IP.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
